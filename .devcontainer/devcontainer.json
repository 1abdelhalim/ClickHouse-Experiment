{
  "name": "ClickHouse Benchmark (Linux, native)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "onCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": "clickhouse client -q \"SELECT version()\" || sudo clickhouse start",
  "customizations": {
    "vscode": {
      "extensions": []
    }
  }
}
